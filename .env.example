# Google Cloud / Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=l200dy5-sandbox-68969
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Strategic Model Routing (Flash for fast copy/critique/compaction, Pro for art direction)
FAST_MODEL=gemini-3.8-flash
PRO_MODEL=gemini-3.8-flash
IMAGE_MODEL=gemini-3.1-flash-image

# Session & Memory
SESSION_DB_URL=sqlite+aiosqlite:///./data/sessions.db

# Observability & Security Toggles (set to true in GCP deployment)
ENABLE_CLOUD_TRACE=false
ENABLE_CLOUD_DLP=false
ENABLE_SECRET_MANAGER=false
LOG_LEVEL=INFO

# Generic Event Branding (override at deploy time via Secret Manager or theme_config.json)
EVENT_TITLE="Holiday Card Studio 2026"
EVENT_FOOTER="Seasons Greetings and Happy 2027!"
REQUIRE_COPY_CONFIRMATION=false
